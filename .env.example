# Django
DEBUG=False
DJANGO_SECRET_KEY=generate-a-long-random-secret-key
ALLOWED_HOSTS=skyconnect-sa.com,www.skyconnect-sa.com
CSRF_TRUSTED_ORIGINS=https://skyconnect-sa.com,https://www.skyconnect-sa.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Application
HIDE_PRODUCT_PRICES=False
MEDIA_URL=/media/
STATIC_URL=/static/

# PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=skyconnect
DB_USER=skyconnect
DB_PASSWORD=replace-with-a-strong-unique-password
DB_HOST=db
DB_PORT=5432

# FreeRADIUS/MySQL (leave RADIUS_DB_HOST empty when not used)
RADIUS_DB_ENGINE=django.db.backends.mysql
RADIUS_DB_NAME=radius
RADIUS_DB_USER=radius_user
RADIUS_DB_PASSWORD=replace-with-a-strong-unique-password
RADIUS_DB_HOST=
RADIUS_DB_PORT=3306
RADIUS_SYNC_ENABLED=False

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@skyconnect-sa.com
EMAIL_HOST_PASSWORD=replace-with-an-smtp-password
EMAIL_COMMERCIAL=contact@skyconnect-sa.com
TELEPHONE_COMMERCIAL=

# Public links and anti-spam
FACEBOOK_URL=
TWITTER_URL=
LINKEDIN_URL=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
